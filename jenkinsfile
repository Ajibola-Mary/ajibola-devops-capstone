pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Java') {
            steps {
                sh 'mvn -f java/pom.xml clean package'
            }
        }

        stage('Terraform') {
            steps {
                withCredentials([
                    string(credentialsId: 'capstone-aws-access-key', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'capstone-aws-secret-key', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    sh '''
                        export AWS_DEFAULT_REGION=eu-west-2
                        terraform -chdir=terraform init
                        terraform -chdir=terraform apply -auto-approve
                    '''
                }
            }
        }

        stage('Get EC2 IP') {
            steps {
                withCredentials([
                    string(credentialsId: 'capstone-aws-access-key', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'capstone-aws-secret-key', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    script {
                        env.EC2_PUBLIC_IP = sh(
                            script: 'terraform -chdir=terraform output -raw ec2_public_ip',
                            returnStdout: true
                        ).trim()
                    }
                }
            }
        }

        stage('Create Ansible Inventory') {
            steps {
                sh '''
                    cat > ansible/inventory.ini <<EOF
[webserver]
${EC2_PUBLIC_IP} ansible_user=ec2-user
EOF
                '''
            }
        }

        stage('Deploy with Ansible') {
            steps {
                sshagent(credentials: ['capstone-ec2-ssh']) {
                    sh '''
                        ANSIBLE_HOST_KEY_CHECKING=False ansible-playbook \
                            -i ansible/inventory.ini \
                            ansible/playbook.yml
                    '''
                }
            }
        }

    }
}

